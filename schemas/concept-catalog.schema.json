{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "smells concept reference catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "catalog_version", "source_manifest", "item_count", "concepts"],
  "properties": {
    "schema_version": {"const": 1},
    "catalog_id": {"const": "smells-core"},
    "catalog_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "source_manifest": {"type": "string", "pattern": "^[a-z0-9-]+@[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "item_count": {"const": 36},
    "concepts": {
      "type": "array",
      "minItems": 36,
      "maxItems": 36,
      "items": {"$ref": "#/$defs/concept"}
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "relationship": {"enum": ["defines", "names", "legacy_alias", "refines", "equates", "classifies", "component", "motivates"]},
    "alias": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source_ids"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_term", "relationship", "reference_url", "source_locator", "ordinal", "access_scope", "reference_role"],
      "properties": {
        "source_id": {"$ref": "#/$defs/identifier"},
        "source_term": {"type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001F\\u007F]+$"},
        "relationship": {"$ref": "#/$defs/relationship"},
        "reference_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "source_locator": {"type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001F\\u007F]+$"},
        "source_category": {"type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001F\\u007F]+$"},
        "ordinal": {"type": "integer", "minimum": 1},
        "access_scope": {"enum": ["full_text", "table_of_contents", "publisher_record"]},
        "reference_role": {"enum": ["catalog_inventory", "concept_guidance", "taxonomy", "metric_detection_pattern", "detection_method"]}
      }
    },
    "language_support_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicability", "detector_support"],
      "properties": {
        "applicability": {"enum": ["applicable", "contextual", "not_applicable", "unsupported"]},
        "detector_support": {"enum": ["none", "research", "preview", "stable", "deprecated"]}
      }
    },
    "language_support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rust", "python", "typescript"],
      "properties": {
        "rust": {"$ref": "#/$defs/language_support_entry"},
        "python": {"$ref": "#/$defs/language_support_entry"},
        "typescript": {"$ref": "#/$defs/language_support_entry"}
      }
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "catalog_state", "summary", "aliases", "references", "language_support"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "name": {"type": "string", "minLength": 1},
        "catalog_state": {"enum": ["candidate", "accepted", "deprecated", "retired"]},
        "summary": {"type": "string", "minLength": 1},
        "aliases": {
          "type": "array",
          "items": {"$ref": "#/$defs/alias"}
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/reference"}
        },
        "language_support": {"$ref": "#/$defs/language_support"}
      },
      "allOf": [
        {
          "if": {"properties": {"catalog_state": {"const": "accepted"}}},
          "then": {"not": {"required": ["name"]}},
          "else": {"required": ["name"]}
        }
      ]
    }
  }
}
